<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.onlinemall.dao.ProdTagDao">

    <resultMap id="BaseResultMap" type="com.example.onlinemall.entity.ProdTag">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="status" column="status"/>
        <result property="style" column="style"/>
        <result property="sortOrder" column="order"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, title, status, style, `order`, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM prod_tag
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM prod_tag
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO prod_tag (title, status, style, `order`, create_time, update_time)
        VALUES (#{title}, #{status}, #{style}, #{sortOrder}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById">
        UPDATE prod_tag
        SET
            title = #{title},
            status = #{status},
            style = #{style},
            `order` = #{sortOrder},
            create_time = #{createTime},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM prod_tag
        WHERE id = #{id}
    </delete>
</mapper>
