<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.onlinemall.dao.CategoryDao">

    <resultMap id="BaseResultMap" type="com.example.onlinemall.entity.Category">
        <id property="categoryId" column="category_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="icon" column="icon"/>
        <result property="pic" column="pic"/>
        <result property="sortOrder" column="order"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        category_id, parent_id, category_name, icon, pic, `order`, status, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM category
        WHERE category_id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM category
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="categoryId" keyColumn="category_id">
        INSERT INTO category (parent_id, category_name, icon, pic, `order`, status, create_time, update_time)
        VALUES (#{parentId}, #{categoryName}, #{icon}, #{pic}, #{sortOrder}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById">
        UPDATE category
        SET
            parent_id = #{parentId},
            category_name = #{categoryName},
            icon = #{icon},
            pic = #{pic},
            `order` = #{sortOrder},
            status = #{status},
            create_time = #{createTime},
            update_time = #{updateTime}
        WHERE category_id = #{categoryId}
    </update>

    <delete id="deleteById">
        DELETE FROM category
        WHERE category_id = #{id}
    </delete>
</mapper>
