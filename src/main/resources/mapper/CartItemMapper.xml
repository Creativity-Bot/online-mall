<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.onlinemall.dao.CartItemDao">

    <resultMap id="BaseResultMap" type="CartItem">
        <id property="cartItemId" column="cart_item_id"/>
        <result property="prodId" column="prod_id"/>
        <result property="shopId" column="shop_id"/>
        <result property="skuId" column="sku_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="prodCount" column="prod_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        cart_item_id, prod_id, shop_id, sku_id, customer_id, prod_count, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM cart_item
        WHERE cart_item_id = #{id}
    </select>

    <select id="selectByCustomerId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM cart_item
        WHERE customer_id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM cart_item
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="cartItemId" keyColumn="cart_item_id">
        INSERT INTO cart_item (prod_id, shop_id, sku_id, customer_id, prod_count, create_time, update_time)
        VALUES (#{prodId}, #{shopId}, #{skuId}, #{customerId}, #{prodCount}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateById">
        UPDATE cart_item
        SET
            prod_id = #{prodId},
            shop_id = #{shopId},
            sku_id = #{skuId},
            customer_id = #{customerId},
            prod_count = #{prodCount},
            create_time = #{createTime},
            update_time = #{updateTime}
        WHERE cart_item_id = #{cartItemId}
    </update>

    <delete id="deleteById">
        DELETE FROM cart_item
        WHERE cart_item_id = #{id}
    </delete>
</mapper>
